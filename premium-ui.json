{
  "profile": "product-admin",
  "sourceRoots": [
    "app/web/src/features/admin/webinars",
    "app/web/src/features/sales",
    "app/web/src/features/notifications",
    "app/web/src/features/admin/sales",
    "app/web/src/features/admin/notifications"
  ],
  "locale": "en-US",
  "canonicalMap": "UX-CONTRACT.md",
  "requiredCapabilities": [
    "Select/Listbox",
    "Date",
    "Form",
    "Scrollbar",
    "Toast",
    "CRUD"
  ],
  "ownership": {
    "Select/Listbox": "authored",
    "Date": "native"
  },
  "requiredCommands": [
    "backend-build",
    "backend-lint",
    "web-typecheck",
    "web-lint",
    "test",
    "production-build",
    "premium"
  ],
  "commands": {
    "backend-build": "npm --prefix app/backend run build",
    "backend-lint": "npm --prefix app/backend run lint",
    "web-typecheck": "npm --prefix app/web run typecheck",
    "web-lint": "npm --prefix app/web run lint",
    "test": "npm --prefix app/backend test && npm --prefix app/web test",
    "production-build": "npm run build",
    "premium": "python3 <frontend-design-premium>/scripts/audit_project.py . --mode strict"
  }
}
